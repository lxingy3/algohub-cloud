DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
# Lifecycle scripts require an isolated *-test database and a matching local app handshake.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/algohub-test?schema=public"
# ALLOW_TEST_WRITES="1"
# ENABLE_TEST_DATABASE_HANDSHAKE="1"
# TEST_DATABASE_HANDSHAKE_SECRET="replace-with-at-least-24-random-characters"
JURISDICTION_ID="pittsburgh"
APP_BASE_URL="http://localhost:3000"

# Replace DATABASE_URL with the pooled Neon connection string.
# Keep the real value in .env or Vercel environment variables, not in source control.

# Auth.js / SSO.
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
MICROSOFT_ENTRA_ID_ID=""
MICROSOFT_ENTRA_ID_SECRET=""
MICROSOFT_ENTRA_ID_TENANT_ID=""

# Password reset email. RESEND_API_KEY is required before reset emails can be sent.
PASSWORD_RESET_EMAIL_ENABLED="false"
RESEND_API_KEY=""
PASSWORD_RESET_FROM_EMAIL="AlgoStories <onboarding@resend.dev>"
PASSWORD_RESET_REPLY_TO="xil594@pitt.edu"

# Firebase Cloud Storage / Google Cloud Storage signed media URLs.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# Optional shared secret for calling /api/transcription/process from a future ML job runner.
TRANSCRIPTION_PROCESS_SECRET=""

# ML Quick Test model services.
# Default Task 1-5 behavior is local/open-source model execution.
# Set endpoint values only for self-hosted workers, not hosted model APIs.
ML_TASK1_ENDPOINT=""
TASK1_PYTHON=""
TASK1_WHISPER_MODEL="small"
# Timeout for a full Task 1 worker upload and transcription request.
TASK1_WORKER_TIMEOUT_MS="3600000"
TASK25_PYTHON=""
TASK2_IMPACT_MODEL="facebook/bart-large-mnli"
TASK3_THEME_MODEL="facebook/bart-large-mnli"
ML_IMPACT_ENDPOINT=""
ML_BART_ENDPOINT=""

# Task 4 and Task 5 must use the PPT-specified Python tools.
# Point these at a worker that runs spaCy and KeyBERT.
ML_SPACY_ENDPOINT=""
ML_KEYBERT_ENDPOINT=""
ML_WORKER_TOKEN=""
# Task 2-5 endpoint calls are capped at 90 seconds in lib/mlFullAnalysis.js.
ML_TASK_TIMEOUT_MS="90000"
ML_TASK_RETRY_COUNT="1"

# Shared secret for the external Task 2-5 queue endpoints.
ML_PROCESS_SECRET=""

# Vercel Cron automatically sends this value as:
# Authorization: Bearer $CRON_SECRET
CRON_SECRET=""

# Optional LibreTranslate-compatible endpoint for translating database and
# user-generated page text that is not covered by static i18n resources.
TRANSLATION_API_URL=""
TRANSLATION_API_KEY=""
